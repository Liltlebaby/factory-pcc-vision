{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.local/contracts/station-ai-status.v1.schema.json",
  "title": "Station AI Status v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["station_id", "data_status", "cameras"],
  "properties": {
    "station_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,100}$" },
    "data_status": { "enum": ["live", "offline", "not_installed"] },
    "cameras": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["camera_id", "station_id", "camera_status", "data_status", "updated_at", "camera_fps", "tasks"],
        "properties": {
          "camera_id": { "type": "string" },
          "station_id": { "type": "string" },
          "camera_status": { "enum": ["online", "offline", "not_installed"] },
          "data_status": { "enum": ["live", "offline", "not_installed"] },
          "updated_at": { "type": ["string", "null"], "format": "date-time" },
          "camera_fps": { "type": "number", "minimum": 0 },
          "tasks": { "type": "array", "items": { "type": "object" } }
        }
      }
    }
  }
}

