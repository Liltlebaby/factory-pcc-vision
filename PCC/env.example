# Server-only Supabase credentials. Copy this file to .env.local.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Browser-safe Supabase Auth configuration. The publishable key is expected to
# be public; never put SUPABASE_SECRET_KEY in a NEXT_PUBLIC variable.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Keep false until users have been created and assigned app_metadata.pcc_role.
PCC_AUTH_REQUIRED=false

# Optional compatibility for projects that still use legacy JWT keys.
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Existing Camera 09 service connection.
RACK_API_URL=http://127.0.0.1:8011
# RACK_API_TOKEN=
# Required in production for POST /api/integrations/rack-monitor/sync.
PCC_SYNC_TOKEN=replace-with-a-long-random-secret
PCC_TELEMETRY_TOKEN=replace-with-a-different-long-random-secret
# Keep false when PCC must remain available while a camera is under maintenance.
PCC_REQUIRE_VISION_READY=false
DEPLOYMENT_VERSION=local
# URL ของระบบ Rack Monitor สำหรับปุ่มเปิดดูกล้อง (PCC จะไม่โหลดภาพกล้องเอง)
NEXT_PUBLIC_RACK_MONITOR_URL=http://127.0.0.1:8011
# บอร์ด H2S (ESP32 Wi-Fi) ที่จุดตรวจกลิ่นยาง — PCC ดึง /status จากที่นี่ทุกวินาที
# ถ้าต่อบอร์ดผ่าน USB แทน ให้ชี้ไปที่ sensor-gateway เช่น http://127.0.0.1:8022
# ไม่มีเซ็นเซอร์ H2S ติดตั้งอยู่: ตั้งเป็น off (หน้าจอขึ้น "ยังไม่ติดตั้ง")
H2S_GATEWAY_URL=http://192.168.1.60
# 'legacy' = ใช้หน้าภาพรวมแบบเดิม (ค่าเริ่มต้นคือแบบใหม่)
# NEXT_PUBLIC_PCC_LAYOUT=legacy
