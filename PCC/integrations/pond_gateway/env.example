# Never commit real tokens. Copy to a private service environment file.
PCC_TELEMETRY_URL=http://127.0.0.1:3000/api/v1/telemetry
PCC_TELEMETRY_TOKEN=replace-with-the-same-secret-as-pcc

# mock sends source_mode=demo; modbus sends source_mode=live.
POND_GATEWAY_MODE=mock
POND_SITE_ID=factory-01
POND_LINE_ID=line-1
POND_STATION_ID=final-pond
POND_DEVICE_ID=pond-gateway-01
POND_SAMPLE_INTERVAL_SECONDS=5
POND_SPOOL_PATH=./data/pond-gateway-spool.sqlite3
POND_HEARTBEAT_PATH=./data/pond-gateway-heartbeat.json

# RS485 bus. Windows example COM3; Linux example /dev/ttyUSB0.
POND_SERIAL_PORT=COM3
POND_SERIAL_BAUDRATE=9600
POND_SERIAL_BYTESIZE=8
POND_SERIAL_PARITY=N
POND_SERIAL_STOPBITS=1
POND_SERIAL_TIMEOUT_SECONDS=2

# Confirm every value from the sensor manual before selecting modbus mode.
# Register addresses in PyModbus are zero-based.
POND_PH_SLAVE_ID=1
POND_PH_REGISTER_TYPE=holding
POND_PH_REGISTER_ADDRESS=0
POND_PH_SCALE=0.01
POND_PH_OFFSET=0
POND_PH_SIGNED=false

POND_TEMPERATURE_SLAVE_ID=1
POND_TEMPERATURE_REGISTER_TYPE=holding
POND_TEMPERATURE_REGISTER_ADDRESS=1
POND_TEMPERATURE_SCALE=0.1
POND_TEMPERATURE_OFFSET=0
POND_TEMPERATURE_SIGNED=false
