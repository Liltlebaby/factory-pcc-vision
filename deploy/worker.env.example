# Copy to an untracked file for each external camera worker.
VISION_API_URL=http://vision-monitor:8011
VISION_CAMERA_ID=ppe-camera
VISION_API_TOKEN=replace-with-the-same-RACK_API_TOKEN-used-by-vision-monitor
VISION_HEARTBEAT_SECONDS=5
VISION_HEARTBEAT_TIMEOUT_SECONDS=5

# Adapter callable. It returns the heartbeat dictionary documented in
# docs/operations/vision-monitor-architecture.md.
VISION_WORKER_PROVIDER=company_workers.ppe:heartbeat

# Keep camera credentials and model paths in the worker environment only.
PPE_CAMERA_RTSP=rtsp://viewer:password@nvr-host:554/Streaming/Channels/1001
PPE_MODEL_PATH=/models/ppe-production.pt
