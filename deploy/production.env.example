# Copy to deploy/production.env. Never commit the real file.

# Compose/build settings. Use public HTTPS URLs when accessed from other PCs.
PCC_PORT=3000
VISION_MONITOR_PORT=8011
PUBLIC_VISION_MONITOR_URL=https://vision.factory.example
PCC_PUBLIC_URL=https://pcc.factory.example
CAMERA_REGISTRY_PATH=rack_ai/cameras.json
PRIMARY_CAMERA_ID=camera-09
WORKER_STALE_SECONDS=15
RACK_MODEL_FILE=./models/best_v3.pt
RACK_BACKUP_DIR=./backups/rack_ai
DEPLOYMENT_VERSION=2026.09.21-1

# PCC server-only database connection.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
PCC_AUTH_REQUIRED=true

# Integration secrets. Generate different random values for each purpose.
RACK_API_TOKEN=replace-with-a-long-random-secret
PCC_SYNC_TOKEN=replace-with-a-different-long-random-secret
PCC_TELEMETRY_TOKEN=replace-with-another-long-random-secret
SYNC_INTERVAL_SECONDS=10

# PCC stays usable for sensor monitoring while a camera is under maintenance.
PCC_REQUIRE_VISION_READY=false

# Vision Monitor. Keep RTSP credentials only in this untracked server file.
CAMERA_RTSP_AI=rtsp://viewer:password@nvr-host:554/Streaming/Channels/901
CAMERA_RTSP_RECORD=
PCC_ORIGINS=https://pcc.factory.example,https://vision.factory.example
INFERENCE_FPS=5
RACK_CONFIDENCE=0.55
RACK_IOU=0.70
RACK_IMGSZ=512
RACK_HALF=off
COUNT_LINE_RATIO=0.60
COUNT_ANCHOR=center
MIN_DOWNWARD_PIXELS=10
EVENT_COOLDOWN_SECONDS=1.5
COUNT_DEDUPE=spatial
COUNT_DUPLICATE_IOU=0.55
COUNT_DUPLICATE_CONTAINMENT=0.80
CAMERA_RETRY_SECONDS=3
CAMERA_STALE_SECONDS=5
RECORD_MODE=auto
RECORD_FPS=10

# Optional Final Pond RS485 Gateway. Confirm every register with the exact
# sensor manual before enabling the `pond-iot` Compose profile.
POND_GATEWAY_MODE=modbus
POND_SERIAL_DEVICE_HOST=/dev/ttyUSB0
POND_SERIAL_DEVICE_CONTAINER=/dev/ttyUSB0
POND_SERIAL_BAUDRATE=9600
POND_SERIAL_BYTESIZE=8
POND_SERIAL_PARITY=N
POND_SERIAL_STOPBITS=1
POND_DEVICE_ID=pond-gateway-01
POND_SAMPLE_INTERVAL_SECONDS=5
POND_PH_SLAVE_ID=REPLACE_FROM_SENSOR_MANUAL
POND_PH_REGISTER_TYPE=REPLACE_FROM_SENSOR_MANUAL
POND_PH_REGISTER_ADDRESS=REPLACE_FROM_SENSOR_MANUAL
POND_PH_SCALE=REPLACE_FROM_SENSOR_MANUAL
POND_PH_OFFSET=0
POND_PH_SIGNED=false
POND_TEMPERATURE_SLAVE_ID=REPLACE_FROM_SENSOR_MANUAL
POND_TEMPERATURE_REGISTER_TYPE=REPLACE_FROM_SENSOR_MANUAL
POND_TEMPERATURE_REGISTER_ADDRESS=REPLACE_FROM_SENSOR_MANUAL
POND_TEMPERATURE_SCALE=REPLACE_FROM_SENSOR_MANUAL
POND_TEMPERATURE_OFFSET=0
POND_TEMPERATURE_SIGNED=false
